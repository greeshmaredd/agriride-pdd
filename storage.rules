rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    match /profileImages/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /equipmentImages/{equipmentId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /equipmentDocuments/{ownerId}/{equipmentId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /communityImages/{postId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /productImages/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
