<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvCartTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shopping Cart"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCartItem1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tvCartTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:id="@+id/tvCartItemNames" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paddy Seeds BPT 5204 (2x) + Urea Bag (1x)" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvCartItemBreakdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Items: 2 Products (3 Total Units)" android:textColor="@color/primary_green" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCartSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardCartItem1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Subtotal:" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <TextView android:id="@+id/tvSubtotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹1,967" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Delivery Charges:" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <TextView android:id="@+id/tvDeliveryFee" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹50" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" android:layout_marginVertical="10dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Amount:" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvCartTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹2,017" android:textColor="@color/primary_green" android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckoutCart"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="@color/primary_green"
        android:text="Place Order (Cash on Delivery)"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
