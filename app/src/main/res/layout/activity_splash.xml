<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_forest_green"
    android:padding="24dp">

    <!-- Center Content Group -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btnTapToContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Logo Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:cardBackgroundColor="#175227"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp"
            app:strokeColor="#2E8042"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_tractor"
                app:tint="@color/surface_white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AgriRide"
            android:textColor="@color/surface_white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Farm Equipment Booking System"
            android:textColor="#92C79B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Motto Pill Tag -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_splash_pill_tag"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="&quot;Smart Farming. Easy Booking.&quot;"
            android:textColor="@color/tagline_orange"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Loading Progress Spinner -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/accent_yellow" />
    </LinearLayout>

    <!-- Tap to Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTapToContinue"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_splash_button"
        android:text="Tap to Continue ➔"
        android:textColor="@color/surface_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:strokeColor="#367C47"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
