<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Top Green Header Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEarnHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/primary_green"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <ImageButton
                android:id="@+id/btnEarnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_splash_button"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/surface_white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvEarnTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Earnings &amp; Workers"
                android:textColor="@color/surface_white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardEarnHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Total Monthly Payout Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEarningsMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary_green"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Monthly Fleet Revenue"
                        android:textColor="#C8E6C9"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalEarningsAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="₹58,400"
                        android:textColor="@color/accent_yellow"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNetProfitSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Net Owner Profit: ₹34,200 (After Driver Wages &amp; Fuel)"
                        android:textColor="#E8F5E9"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="#43A047" />

                    <!-- Bottom row with Driver Wages, Today, and Pending -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTodaysEarnings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Today: ₹4,800"
                            android:textColor="@color/surface_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDriverWagesPaid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:text="👷 Driver Wages: ₹18,000"
                            android:textColor="#FFF59D"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPendingCashEarnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending: ₹6,200"
                            android:textColor="@color/surface_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daily Target & Budget Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎯 Daily Earnings Target / రోజువారీ బడ్జెట్"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetDailyTarget"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set Target"
                            android:textColor="@color/primary_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDailyTargetProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Target: ₹5,000 | Earned Today: ₹4,800"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/progressDailyTarget"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="96"
                        android:progressTint="@color/primary_green" />

                    <TextView
                        android:id="@+id/tvDailyTargetStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Status: 96% Met! Keep it up! 🌟"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weekly Earnings Growth -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Weekly Fleet Earnings &amp; Operation Trends"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Labeled Bar Chart Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <!-- Mon -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDayMonAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹3.6k"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/viewDayMonBar"
                                android:layout_width="18dp"
                                android:layout_height="36dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="#81C784" />
                        </LinearLayout>

                        <!-- Tue -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDayTueAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹1.2k"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/viewDayTueBar"
                                android:layout_width="18dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="#81C784" />
                        </LinearLayout>

                        <!-- Wed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDayWedAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹4.8k"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/viewDayWedBar"
                                android:layout_width="18dp"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="#4CAF50" />
                        </LinearLayout>

                        <!-- Thu -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDayThuAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹2.4k"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/viewDayThuBar"
                                android:layout_width="18dp"
                                android:layout_height="24dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="#81C784" />
                        </LinearLayout>

                        <!-- Fri -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDayFriAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/viewDayFriBar"
                                android:layout_width="18dp"
                                android:layout_height="4dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="#E0E0E0" />
                        </LinearLayout>

                        <!-- Sat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDaySatAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹6.0k"
                                android:textColor="@color/primary_green"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/viewDaySatBar"
                                android:layout_width="18dp"
                                android:layout_height="60dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="@color/primary_green" />
                        </LinearLayout>

                        <!-- Sun -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="bottom|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDaySunAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0.4k"
                                android:textColor="@color/text_secondary"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/viewDaySunBar"
                                android:layout_width="18dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="#81C784" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Labels Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Mon"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Tue"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Wed"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Thu"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Fri"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Sat"
                            android:textColor="@color/primary_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Sun"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Assigned Worker Roster Title & Add Driver Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👷 Fleet Drivers Roster"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddWorker"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/primary_green"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="+ Add Driver"
                    android:textColor="@color/surface_white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- Worker List Recycler View -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWorkers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvEmptyWorkers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No operators registered. Add a worker to assign jobs."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Backward compatibility elements with previous implementation -->
            <TextView
                android:id="@+id/tvEarningsSummarySub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
