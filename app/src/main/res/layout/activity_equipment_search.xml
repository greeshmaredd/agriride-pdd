<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Top Header Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="0dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageButton
                android:id="@+id/btnSearchBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚜 Book Farm Machinery"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📍 Real Nearby Vehicles (వ్యవసాయ యంత్రాలు)"
                    android:textColor="@color/primary_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Horizontal Quick Vehicle Type Selector (NO TYPING NEEDED) -->
    <HorizontalScrollView
        android:id="@+id/hsvVehicleTypes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/cardSearchHeader">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupVehicles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <!-- All Vehicles -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipAllVehicles"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🌾 All Machines"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Tractors -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatTractor"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚜 Tractors"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Harvesters -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatHarvester"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾 Harvesters"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Spray Drones -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatDrone"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚁 Spray Drones"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Rotavators -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatRotavator"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚜 Rotavators"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Transplanters -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatTransplanter"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Transplanters"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Sprayers -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatSprayer"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💦 Sprayers"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Threshers -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatThresher"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾 Threshers"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />

            <!-- Straw Balers -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatBaler"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚜 Straw Balers"
                android:textColor="@color/text_primary"
                app:chipCornerRadius="16dp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Secondary Filter Bar (Distance & Rating only, PRICE BUTTON REMOVED) -->
    <LinearLayout
        android:id="@+id/layoutFilterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/hsvVehicleTypes">

        <!-- Distance Dropdown Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipDistanceFilter"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="📍 Distance: Nearest ˅"
            android:textColor="@color/primary_green"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/surface_white"
            app:chipCornerRadius="16dp"
            app:chipStrokeColor="@color/primary_green"
            app:chipStrokeWidth="1.2dp" />

        <!-- Rating Dropdown Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipRatingFilter"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Rating: All ˅"
            android:textColor="@color/text_primary"
            app:chipBackgroundColor="@color/surface_white"
            app:chipCornerRadius="16dp"
            app:chipStrokeColor="@color/border_light"
            app:chipStrokeWidth="1dp" />
    </LinearLayout>

    <!-- Results Count Header -->
    <TextView
        android:id="@+id/tvResultsCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="Found Nearby Available Machines"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutFilterRow" />

    <!-- RecyclerView for Search Results -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvResultsCount" />

    <!-- Empty State View -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="🚜\nNo equipment available in your area.\nTry adjusting your search or distance filter."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvResultsCount" />

</androidx.constraintlayout.widget.ConstraintLayout>
