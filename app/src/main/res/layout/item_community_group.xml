<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGroupItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E8ECE9"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Group Avatar Circle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGroupAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="#2E7D32"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvGroupAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🌾"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Group Title -->
        <TextView
            android:id="@+id/tvGroupName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🌾 Mevalurkuppam Farmers Circle"
            android:textColor="#1A2E1C"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardGroupAvatar"
            app:layout_constraintTop_toTopOf="@id/cardGroupAvatar"
            app:layout_constraintEnd_toStartOf="@id/tvGroupTime" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvGroupTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:45 PM"
            android:textColor="#78909C"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvGroupName" />

        <!-- Last Message Snippet -->
        <TextView
            android:id="@+id/tvGroupLastMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Kalyan Ram: Tractor &amp; Drone sprayers available today!"
            android:textColor="#546E7A"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/cardGroupAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvGroupName"
            app:layout_constraintEnd_toStartOf="@id/chipGroupMembersCount" />

        <!-- Members Count Badge -->
        <TextView
            android:id="@+id/chipGroupMembersCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_system_event"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="👥 5 members"
            android:textColor="#37474F"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGroupTime" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
