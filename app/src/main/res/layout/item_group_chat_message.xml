<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="3dp">

    <!-- 1. System Event Message (Centered Pill) -->
    <LinearLayout
        android:id="@+id/layoutSystemEvent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvSystemMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_system_event"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="🌾 greeshma created group"
            android:textColor="#546E7A"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- 2. Incoming Message (Left Bubble) -->
    <LinearLayout
        android:id="@+id/layoutIncoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bg_chat_bubble_incoming"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Sender Name & Phone -->
            <TextView
                android:id="@+id/tvIncomingSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kalyan Ram (+91 94401 55667)"
                android:textColor="#1B5E20"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Message Text -->
            <TextView
                android:id="@+id/tvIncomingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Soil moisture is good! Need drone spraying for pest control."
                android:textColor="#263238"
                android:textSize="14sp" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/tvIncomingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="3:42 PM"
                android:textColor="#90A4AE"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Outgoing Message (Right Bubble) -->
    <LinearLayout
        android:id="@+id/layoutOutgoing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:background="@drawable/bg_chat_bubble_outgoing"
            android:elevation="1dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Message Text -->
            <TextView
                android:id="@+id/tvOutgoingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes, Garuda Kisan Drone is ready for booking at ₹650/acre!"
                android:textColor="#1A2E1C"
                android:textSize="14sp" />

            <!-- Timestamp & Checkmark -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOutgoingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3:45 PM"
                    android:textColor="#2E7D32"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="✓✓"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
